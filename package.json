{
    "name": "subpeek",
    "description": "SubPeek - Caption & Dub Labels for YouTube",
    "private": true,
    "version": "1.2.0",
    "license": "GPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "postinstall": "wxt prepare",
        "screenshots": "node store-assets/screenshots/src/render.mjs store-assets/screenshots/src/slides store-assets/screenshots",
        "test": "vitest run",
        "test:watch": "vitest",
        "probe:toggle": "node probes/toggle-check.mjs",
        "probe:toggle:firefox": "node probes/toggle-check-firefox.mjs",
        "probe:hover": "node probes/hover-check.mjs",
        "probe:messaging": "node probes/messaging-check.mjs",
        "probe:search-keys": "node probes/search-keys-check.mjs",
        "probe:origin": "node probes/origin-check.mjs",
        "probe:filter": "node probes/filter-check.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.2",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "prettier": "^3.7.4",
        "prettier-plugin-organize-imports": "^4.3.0",
        "sass-embedded": "^1.97.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^4.1.11",
        "wxt": "^0.21.4"
    },
    "dependencies": {
        "iso-639-1": "^3.1.5",
        "lit-html": "^3.3.3",
        "p-limit": "^7.2.0"
    }
}
